# ============================================
# AI Gigaschool - Переменные окружения
# ============================================
# Скопируйте этот файл в .env и заполните своими значениями
# cp env.example .env
# или на Windows: copy env.example .env

# ============================================
# Docker Compose (имена контейнеров)
# ============================================
# Общий префикс для container_name: получится, например, myproj-crud, myproj-llm.
# Сетевые имена сервисов (crud-service, core, vector-store, …) не меняются — URL вида http://core:8020 те же.
# DOCKER_CONTAINER_PREFIX=ai-gigaschool

# Два файла compose:
#   1) Phoenix:   docker compose -f docker-compose.phoenix.yml --env-file .env up -d
#   2) Проект:    docker compose --env-file .env up -d
# В основном файле сервиса phoenix нет; llm-service шлёт OTLP на host.docker.internal (порт с docker-compose.phoenix.yml).

# Порты Phoenix на хосте (docker-compose.phoenix.yml): при смене HTTP-порта укажите тот же в PHOENIX_COLLECTOR_ENDPOINT.
# PHOENIX_HOST_HTTP_PORT=6006
# PHOENIX_HOST_GRPC_PORT=4317

# docker-compose-agent-tests.yaml: проброс HTTP agent-rest-service на хост (ноутбук / скрипт агента → http://localhost:8040)
# AGENT_REST_PUBLISHED_PORT=8040
# URL для agent-tests/agent_match5_eval.ipynb при запуске стека в Docker:
# AGENT_REST_URL=http://localhost:8040
# Таймаут HTTP к agent-rest из ноутбука (сек); держите выше, чем CORE_HTTP_TIMEOUT_TOTAL_SECONDS у контейнера agent-rest.
# AGENT_REST_HTTP_TIMEOUT=660
# Таймауты aiohttp в agent-rest-module при вызове core (start_talk и др.); при медленном провайдере увеличьте total.
# CORE_HTTP_TIMEOUT_TOTAL_SECONDS=600
# CORE_HTTP_TIMEOUT_CONNECT_SECONDS=30

# ============================================
# LLM Провайдер (Model API)
# ============================================

# Выберите провайдер LLM: yandex, openai, openrouter, anthropic, google, mistral
LLM_PROVIDER=yandex

# Ретраи structured tool_call (llm-service): число попыток и пауза между ними
# LLM_TOOL_CALL_MAX_ATTEMPTS=4
# LLM_TOOL_CALL_RETRY_BACKOFF_SEC=0.35

# Логирование успешных вызовов LLM в llm-service (отдельный файл, не stdout): off | summary | full
# Файл по умолчанию: $LOG_ROOT/llm-service/llm_calls.log (локально ./logs/llm-service/llm_calls.log)
# LLM_CALL_LOG=summary
# LLM_CALL_LOG_FILE=/app/logs/llm-service/my_llm_audit.log
# LLM_CALL_LOG_TEXT_MAX=2000

# --- Yandex Cloud (по умолчанию) ---
YANDEX_CLOUD_FOLDER=your_yandex_folder_id
YANDEX_CLOUD_API_KEY=your_yandex_api_key
# Модель Yandex LLM (подставляется в gpt://<folder_id>/<model>)
# YANDEX_CLOUD_MODEL=yandexgpt-5-lite

# --- OpenAI (если LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=your_openai_api_key

# --- OpenRouter (если LLM_PROVIDER=openrouter) ---
# OPENROUTER_API_KEY=your_openrouter_api_key
# Модель чата (id на openrouter.ai; переопределяет дефолт openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Атрибуция приложения (рекомендуется; см. openrouter.ai/docs/app-attribution)
# OPENROUTER_APP_URL=https://your-app-url.example
# OPENROUTER_APP_TITLE=AI-Gigaschool
# Синонимы заголовков (если не заданы APP_*):
# OPENROUTER_HTTP_REFERER=https://your-app-url.example
# OPENROUTER_X_TITLE=AI-Gigaschool

# --- Anthropic/Claude (если LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Google/Gemini (если LLM_PROVIDER=google) ---
# GOOGLE_API_KEY=your_google_api_key

# --- Mistral (если LLM_PROVIDER=mistral или RAG_EMBEDDING_PROVIDER=mistral) ---
# MISTRAL_API_KEY=your_mistral_api_key

# ============================================
# Трассировка LLM в Arize Phoenix (llm-service)
# ============================================
# Phoenix поднимается отдельно: docker-compose.phoenix.yml (UI: http://localhost:<PHOENIX_HOST_HTTP_PORT>).
# В docker-compose.yml у llm-service задан extra_hosts для host.docker.internal (Linux через host-gateway).
# По умолчанию отправка OTLP: http://host.docker.internal:6006 (совпадает с PHOENIX_HOST_HTTP_PORT=6006).
# PHOENIX_COLLECTOR_ENDPOINT=http://host.docker.internal:6006

# Несколько стеков приложения на один Phoenix: общий файл docker-compose.phoenix.yml, у каждого стека свой
# PHOENIX_PROJECT_NAME; при нестандартном порте Phoenix переопределите PHOENIX_COLLECTOR_ENDPOINT под тот порт.

# PHOENIX_TRACING_ENABLED=0
# Локальный процесс llm на хосте, Phoenix тоже на хосте (в код дописывается путь /v1/traces для HTTP):
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_PROJECT_NAME=ai-gigaschool-llm
# Транспорт: http/protobuf (порт 6006) или grpc (порт 4317, endpoint вида http://phoenix:4317 или host:4317)
# PHOENIX_OTLP_PROTOCOL=http/protobuf

# ============================================
# RAG / FAISS (микросервис vector_store; Core и model ходят по HTTP)
# ============================================
# Docker Compose: http://vector-store:8030; локально: http://localhost:8030
# VECTOR_STORE_SERVICE_URL=http://localhost:8030

# Провайдер эмбеддингов: yandex | openai | google | mistral | openrouter (как в model/llm_adapter).
# Если пусто — совпадает с LLM_PROVIDER. Anthropic для эмбеддингов не поддерживается.
# RAG_EMBEDDING_PROVIDER=yandex
# Опечатка mistal воспринимается как mistral (vector-store / llm_adapter).

# --- Yandex Embeddings (RAG_YANDEX_*; пустые поля = дефолты LangChain) ---
# RAG_YANDEX_EMBEDDING_QUERY_MODEL=text-search-query
# RAG_YANDEX_EMBEDDING_DOC_MODEL=text-search-doc
# RAG_YANDEX_EMBEDDING_MODEL_VERSION=latest

# --- OpenAI / Google / Mistral: модель эмбеддингов (ключи см. выше) ---
# RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RAG_GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
# RAG_MISTRAL_EMBEDDING_MODEL=mistral-embed

# --- OpenRouter: эмбеддинги через тот же API, что и LLM (OPENROUTER_* выше) ---
# RAG_EMBEDDING_PROVIDER=openrouter
# RAG_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Каталоги индексов: по умолчанию data/profession/profession_vector/<slug>/ и data/education/education_vector/<slug>/
# FAISS_PROFESSION_VECTOR_ROOT=data/profession/profession_vector
# FAISS_COURSES_VECTOR_ROOT=data/education/education_vector
# Полный путь к индексу без подкаталога провайдера (перекрывает *_VECTOR_ROOT):
# FAISS_PROFESSION_INDEX_DIR=
# FAISS_COURSES_INDEX_DIR=

# Исходные JSON для пересборки индексов (по умолчанию пути внутри data/):
# FAISS_PROFESSION_SOURCE_JSON=data/profession/summary_hh_professions_comparison.json
# FAISS_EDUCATION_SOURCE_JSON=data/education/education_comparison.json

# POST /v1/admin/rebuild-faiss-indexes — заголовок Authorization: Bearer <секрет>
# CORE_REBUILD_FAISS_SECRET=change_me_long_random

# ============================================
# Telegram Bot
# ============================================
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# URL Core API (оркестрация, LangGraph). Эндпоинты совместимы со старыми путями /start_talk/ и т.д.
# Docker Compose (хост): http://localhost:8000
# Внутри compose сеть бота: http://core:8020
LLM_BASE_URL=http://localhost:8000

# Локальная отладка без Docker (если сервисы подняты по отдельности):
# CRUD_SERVICE_URL=http://localhost:8010
# LLM_SERVICE_URL=http://localhost:8001

# CRUD: провайдер для пути /users/{id}/session (по умолчанию telegram)
# DEFAULT_IDENTITY_PROVIDER=telegram

# Core: уровень логов (DEBUG, INFO, WARNING). Логи — в stdout контейнера / терминала uvicorn.
# CORE_LOG_LEVEL=INFO

# Core: пошаговый тест v2 и кнопки профессий в одном ответе (v1 — отдельный ход без списка).
# TEST_RUN_VERSION=v2
# Если включено и TEST_RUN_VERSION=v1, этап теста пропускается и идёт немедленный переход к рекомендациям.
# SKIP_TEST_V1_TO_RECOMMENDATION=0

# ============================================
# HeadHunter API (для парсеров)
# ============================================
# Опционально, если используете парсеры HH
# HH_CLIENT_ID=your_hh_client_id
# HH_CLIENT_SECRET=your_hh_client_secret
# HH_REDIRECT_URI=your_hh_redirect_uri


